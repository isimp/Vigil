<Project Sdk="Microsoft.NET.Sdk">

  <!-- Puts Vigil's hook layout (kinds and priorities) on game-shaped methods with the HarmonyX
       that BepInEx ships, and checks that the methods still do what they did.
       Run with: dotnet run -c Release (project tools/HookShapeCheck). Exit code 1 when a check fails.
       Runs on .NET Framework, like the game's runtime; HarmonyX comes from the mod manager profile
       (set CoreDir to another BepInEx/core folder if needed).
       Not referenced by Vigil.csproj, so the plugin build never builds it. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <CoreDir Condition="'$(CoreDir)' == ''">$(APPDATA)\com.kesomannen.gale\valheim\profiles\Default\BepInEx\core</CoreDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="0Harmony"><HintPath>$(CoreDir)/0Harmony.dll</HintPath></Reference>
    <Reference Include="MonoMod.RuntimeDetour"><HintPath>$(CoreDir)/MonoMod.RuntimeDetour.dll</HintPath></Reference>
    <Reference Include="MonoMod.Utils"><HintPath>$(CoreDir)/MonoMod.Utils.dll</HintPath></Reference>
    <Reference Include="Mono.Cecil"><HintPath>$(CoreDir)/Mono.Cecil.dll</HintPath></Reference>
  </ItemGroup>

</Project>
