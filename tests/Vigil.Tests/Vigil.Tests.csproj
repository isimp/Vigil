<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tests for the part of Vigil that needs no game: what the recorder keeps and how it reads it,
       the load test's plan and verdicts, the help and what each command belongs to, the settings
       and recordings taken over from the mods Vigil replaced, the spawn marks' grid and shapes,
       and the cleanup's selection. src/Core has no Unity or BepInEx reference, so it builds here
       on its own. Run with: dotnet test tests/Vigil.Tests
       Not referenced by Vigil.csproj, so the plugin build never builds it. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Vigil.Tests</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../src/Core/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

</Project>
